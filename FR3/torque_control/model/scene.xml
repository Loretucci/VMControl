<mujoco model="fr3 scene">
  <!-- Simulated plant: the seven FR3 joints receive motor torques from Python. -->
  <include file="fr3.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- Older fixed reference marker; the mobile-rail controller does not use it. -->
    <site name = "reference_site" pos = "0.7 0 0.3" type = "sphere" size = "0.03" rgba = "1 0 0 1"/>
  

    <!-- Visible copy of the virtual carriage. Python replaces this joint's
         position and speed with the values from scene_virtual.xml each step. -->
    <body name= "virtual_mass" pos="0.5545 0 0.6245">
      <!-- s=0 places the site at the body origin; s=0.5 moves it 0.5 m in -x. -->
      <joint name = "rail_joint" type = "slide" axis = "-1 0 0" limited = "true" range = "0 0.5"/>
      <inertial mass = "1" pos = "0 0 0" diaginertia ="0.001 0.001 0.001"/>
      <!-- With no pos attribute, the site is located at the carriage origin. -->
      <site name = "reference_site_mobile" type = "sphere" size = "0.03" rgba = "1 0 0 1"/>
    </body>
    <body name= "virtual_mass_z" pos="0.5545 0 0.3245" gravcomp="1">
      <!-- Positive joint displacement moves the carriage toward world -x. -->
      <joint name = "rail_joint_z" type = "slide" axis = "0 0 1" limited = "true" range = "0 0.55"/>
      <inertial mass = "0.1" pos = "0 0 0" diaginertia ="0.001 0.001 0.001"/>
      <!-- Default site position is 0 0 0 in this body's local frame. -->
      <site name = "reference_site_mobile_z" type = "sphere" size = "0.03" rgba = " 0 0.5 1 1"/>
    </body>   
  </worldbody>
          
</mujoco>
