<mujoco model="fr3 fixed-reference virtual scene">
  <!-- Virtual FR3 for homework2_fr3.py: the reference is fixed in the world. -->
  <include file="fr3_virtual.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <site name="reference_site" pos="0.7 0 0.3" type="sphere" size="0.03" rgba="1 0 0 1"/>
  </worldbody>

  <actuator>
    <position name="x_spring" site="attachment_site" refsite="reference_site" gear="1 0 0 0 0 0" kp="2000" kv="30"/>
    <position name="y_spring" site="attachment_site" refsite="reference_site" gear="0 1 0 0 0 0" kp="2000" kv="30"/>
    <position name="z_spring" site="attachment_site" refsite="reference_site" gear="0 0 1 0 0 0" kp="2000" kv="30"/>
  </actuator>
</mujoco>
